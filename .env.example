# =============================================================================
# Copie este archivo como .env y complete los valores. NUNCA suba .env al repositorio.
#   Windows (PowerShell): Copy-Item .env.example .env
#   Linux / macOS:        cp .env.example .env
# =============================================================================

# --- Servidor ---------------------------------------------------------------
NODE_ENV=development
PORT=3000
# Orígenes permitidos por CORS: * o una lista separada por comas.
CORS_ORIGIN=*

# --- PostgreSQL --------------------------------------------------------------
DB_HOST=localhost
# Si usa docker-compose y el puerto 5432 está ocupado, use otro (p. ej. 5433).
DB_PORT=5432
DB_NAME=catalogo
DB_USER=catalogo
# Contraseña del usuario de PostgreSQL (obligatoria).
DB_PASSWORD=

# --- JWT ----------------------------------------------------------------------
# Secreto aleatorio de al menos 32 caracteres. Genérelo con:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=
# Vigencia del token: <número><s|m|h|d>, p. ej. 15m, 1h, 1d
JWT_EXPIRES_IN=1h

# --- Contraseñas --------------------------------------------------------------
# Costo de bcrypt (entre 10 y 14).
BCRYPT_SALT_ROUNDS=10

# --- Administrador inicial (lo usa: npm run db:admin) -------------------------
# Datos ficticios. La contraseña debe tener 8+ caracteres, con letras y números.
ADMIN_NOMBRE=Administrador del catálogo
ADMIN_CORREO=admin@catalogo.test
ADMIN_CONTRASENA=

# --- Pruebas automáticas (opcional, lo usa: npm run test:postman) -------------
# Puerto del servidor temporal que levanta el script de pruebas.
PUERTO_PRUEBAS=3100
